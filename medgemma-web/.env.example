# MedGemma API configuration (SERVER-SIDE ONLY)
# These variables are read only by Next.js API routes running on the server.
# They are NOT prefixed with NEXT_PUBLIC_, so the API key is never sent to the browser.
#
# Local development: copy this file to .env.local and fill in real values.
# Vercel production: set these in Project Settings -> Environment Variables.

# Base URL of your Kaggle MedGemma endpoint exposed through ngrok.
# Must use HTTPS. Note: ngrok free URLs change every time you restart the tunnel.
MEDGEMMA_API_URL=https://YOUR-NGROK-ADDRESS.ngrok-free.app

# API key expected by the FastAPI server (sent as X-API-Key header).
MEDGEMMA_API_KEY=YOUR_API_KEY_HERE
